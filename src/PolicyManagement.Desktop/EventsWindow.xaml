<Window x:Class="PolicyManagement.Desktop.EventsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Policy Desktop — Live Events" Height="620" Width="860"
        MinHeight="500" MinWidth="700" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Live policy events" />
            <TextBlock Foreground="#667085" Margin="0,4,0,0">
                <Run Text="Tenant: " /><Run FontWeight="SemiBold" Text="{Binding TenantName}" />
                <Run Text="  •  " /><Run Text="{Binding TenantId}" />
            </TextBlock>
            <TextBlock Foreground="#667085" Margin="0,3,0,0" Text="{Binding WebSocketUrl}" />
        </StackPanel>

        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Padding="14,7" Margin="8,0,0,0" Command="{Binding ConnectCommand}" Content="Connect / reconnect" />
                    <Button Padding="14,7" Margin="8,0,0,0" Command="{Binding DisconnectCommand}" Content="Disconnect" />
                    <Button Padding="14,7" Margin="8,0,0,0" Command="{Binding ClearCommand}" Content="Clear" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{Binding StateBrush}" Margin="0,0,8,0" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding ConnectionState}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
            <ListBox ItemsSource="{Binding Events}" BorderThickness="0" Padding="8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding Type}" />
                                <TextBlock Grid.Column="1" Margin="12,0" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Foreground="#667085" HorizontalAlignment="Right"
                                           Text="{Binding OccurredAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
