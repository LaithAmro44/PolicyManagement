<Window x:Class="PolicyManagement.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Policy Desktop — API" Height="720" Width="1100"
        MinHeight="620" MinWidth="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Policy API client" />
            <TextBlock Foreground="#667085" Margin="0,4,0,0"
                       Text="Read tenant-scoped policies and open the live WebSocket feed." />
        </StackPanel>

        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock FontWeight="SemiBold" Text="API base URL" />
                    <TextBox Margin="0,6,0,0" Padding="8,6" Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock FontWeight="SemiBold" Text="WebSocket URL" />
                    <TextBox Margin="0,6,0,0" Padding="8,6" Text="{Binding WebSocketUrl, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock FontWeight="SemiBold" Text="Tenant" />
                    <ComboBox Margin="0,6,0,0" Padding="8,5"
                              ItemsSource="{Binding Tenants}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding TenantId}" />
                </StackPanel>
                <Button Grid.Column="3" Padding="18,8" VerticalAlignment="Bottom"
                        Click="OpenLiveEvents_Click" Content="Open live events" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F8FAFC" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Button Padding="16,7" Command="{Binding RefreshCommand}" Content="Refresh list" />
                            <CheckBox Margin="18,0,0,0" VerticalAlignment="Center"
                                      Content="Enabled only" IsChecked="{Binding EnabledOnly}" />
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Policies}" SelectedItem="{Binding SelectedPolicy}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              CanUserAddRows="False" BorderThickness="0" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="110" />
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="90" />
                            <DataGridTextColumn Header="Updated (UTC)" Binding="{Binding UpdatedAtUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Policy details" />
                    <Button Margin="0,14,0,14" Padding="12,7" HorizontalAlignment="Left"
                            Command="{Binding LoadDetailsCommand}" Content="Load selected details" />
                    <TextBlock TextWrapping="Wrap" LineHeight="22" Text="{Binding DetailsText}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#F8FAFC" CornerRadius="6" Padding="10" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" />
        </Border>
    </Grid>
</Window>
